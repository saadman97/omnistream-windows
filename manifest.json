{
  "manifest_version": 3,
  "key": "",
  "name": "OmniStream — Media Directory & Server Browser",
  "short_name": "OmniStream",
  "version": "2.1.0",
  "description": "Index HTTP open directories, Emby/Jellyfin servers, and JS-rendered pages into a fast local library. Search, filter and play videos straight in your browser with OmniStream.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "downloads",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "cors_rules",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "action": {
    "default_title": "Open OmniStream",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open OmniStream"
    }
  }
}
