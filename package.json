{
  "name": "omnistream-desktop",
  "productName": "OmniStream",
  "version": "2.1.0",
  "description": "Cross-platform desktop media directory browser & native FTP video streaming player with HTTP 206 range seeking, crawler, and local library indexing",
  "main": "electron/main.js",
  "homepage": "https://github.com/saadman97/omnistream-desktop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/saadman97/omnistream-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/saadman97/omnistream-desktop/issues"
  },
  "scripts": {
    "start": "electron .",
    "build:app": "electron-builder --mac --dir --arm64",
    "open:app": "open dist/mac-arm64/OmniStream.app",
    "app": "npm run build:app && npm run open:app",
    "dist:dmg": "electron-builder --mac dmg --arm64",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win:portable": "electron-builder --win portable --x64",
    "dist": "electron-builder",
    "test": "node test/test-ftp.js"
  },
  "build": {
    "appId": "com.omnistream.desktop",
    "productName": "OmniStream",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable"],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg"]
    }
  },
  "keywords": [
    "omnistream",
    "media-browser",
    "media-player",
    "ftp-streaming",
    "ftp-client",
    "video-streamer",
    "open-directory",
    "jellyfin-client",
    "emby-client",
    "electron",
    "macos-app",
    "desktop-app",
    "hls-player",
    "dash-player",
    "range-requests"
  ],
  "author": "OmniStream Team",
  "license": "MIT",
  "dependencies": {
    "basic-ftp": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
